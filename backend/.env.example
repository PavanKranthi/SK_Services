# OTP: set OTP_DEV_MODE=true to log OTPs in the server console (no SMS cost).
# For production SMS in India, sign up at https://msg91.com and set:
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=SATYAM
# MSG91_OTP_TEMPLATE_ID=your_dlt_approved_template_id
# Firebase Admin (verify Phone Auth ID tokens on the server)
# Download service account JSON from Firebase Console -> Project Settings -> Service accounts
# Local dev: path to service account file (do not commit the JSON file).
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Railway/production: paste the full JSON as one line (no URL — not a file path on the internet).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Phone OTP is sent by Firebase on the Android app (not via this API).
