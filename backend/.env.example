# If your DB password contains @ encode it as %40 (e.g. Pass@123 -> Pass%40123)
DATABASE_URL=postgresql://postgres.kvshgpykeqawemlcjezr:SKServices%408986@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

