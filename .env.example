# Android app -> SK Services API (deploy backend/ to Railway/Render)
# Emulator uses host loopback alias:
# Local emulator: http://10.0.2.2:3001
# Production (after Railway deploy): https://YOUR-RAILWAY-DOMAIN
API_BASE_URL=https://YOUR-RAILWAY-DOMAIN

# Optional Gemini key (unused in core flows today)
GEMINI_API_KEY=MY_GEMINI_API_KEY
